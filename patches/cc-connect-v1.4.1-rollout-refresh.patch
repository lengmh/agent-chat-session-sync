+// ExternallyUpdated reports whether another Codex client appended a newer turn
+// after this App Server session's last observed turn. Same-turn trailing writes
+// are absorbed into the baseline because persistence can finish just after the
+// turn/completed notification.
+func (s *appServerSession) ExternallyUpdated() (bool, error) {
+	s.rolloutMu.Lock()
+	defer s.rolloutMu.Unlock()
+
+	current, err := s.readRolloutFingerprintLocked()
+	if err != nil {
+		return false, err
+	}
+	baseline := s.rolloutBaseline
+	if baseline.size == 0 {
+		s.rolloutBaseline = current
+		return false, nil
+	}
+	if current.size == baseline.size && current.modTimeNS == baseline.modTimeNS {
+		return false, nil
+	}
+	if current.size < baseline.size {
+		return true, nil
+	}
+	if baseline.lastTurnID != "" && current.lastTurnID != "" {
+		if current.lastTurnID != baseline.lastTurnID {
+			return true, nil
+		}
+		// A delayed append from the turn we already consumed is not external.
+		s.rolloutBaseline = current
+		return false, nil
+	}
+	return current.size != baseline.size, nil
+}
+
+func (s *appServerSession) recordRolloutBaseline(completedTurnID string) error {
+	s.rolloutMu.Lock()
+	defer s.rolloutMu.Unlock()
+	fingerprint, err := s.readRolloutFingerprintLocked()
+	if err != nil {
+		return err
+	}
+	if ownTurnID := strings.TrimSpace(completedTurnID); ownTurnID != "" {
+		// The live process knows which turn it completed. Prefer that identity
+		// even if another client raced an append between notification and stat;
+		// the next pre-send check will then detect the other turn.
+		fingerprint.lastTurnID = ownTurnID
+	}
+	s.rolloutBaseline = fingerprint
+	return nil
+}
+
+func (s *appServerSession) readRolloutFingerprintLocked() (rolloutFingerprint, error) {
+	threadID := s.CurrentSessionID()
+	if threadID == "" {
+		return rolloutFingerprint{}, fmt.Errorf("thread id is empty")
+	}
+	if s.rolloutPath == "" {
+		s.rolloutPath = findSessionFile(threadID, s.codexHome)
+	}
+	if s.rolloutPath == "" {
+		return rolloutFingerprint{}, fmt.Errorf("rollout file not found for thread %s", threadID)
+	}
+	file, err := os.Open(s.rolloutPath)
+	if err != nil {
+		return rolloutFingerprint{}, fmt.Errorf("open rollout fingerprint: %w", err)
+	}
+	defer file.Close()
+	stat, err := file.Stat()
+	if err != nil {
+		return rolloutFingerprint{}, fmt.Errorf("stat rollout fingerprint: %w", err)
+	}
+	const tailBytes int64 = 1024 * 1024
+	start := stat.Size() - tailBytes
+	if start < 0 {
+		start = 0
+	}
+	if _, err := file.Seek(start, io.SeekStart); err != nil {
+		return rolloutFingerprint{}, fmt.Errorf("seek rollout fingerprint: %w", err)
+	}
+	tail, err := io.ReadAll(file)
+	if err != nil {
+		return rolloutFingerprint{}, fmt.Errorf("read rollout fingerprint: %w", err)
+	}
+	if start > 0 {
+		if newline := bytes.IndexByte(tail, '\n'); newline >= 0 {
+			tail = tail[newline+1:]
+		}
+	}
+	return rolloutFingerprint{
+		size:       stat.Size(),
+		modTimeNS:  stat.ModTime().UnixNano(),
+		lastTurnID: latestRolloutTurnID(tail),
+	}, nil
+}
+
+func latestRolloutTurnID(tail []byte) string {
+	lines := bytes.Split(tail, []byte{'\n'})
+	for i := len(lines) - 1; i >= 0; i-- {
+		if len(bytes.TrimSpace(lines[i])) == 0 {
+			continue
+		}
+		var value any
+		if json.Unmarshal(lines[i], &value) == nil {
+			if turnID := nestedTurnID(value); turnID != "" {
+				return turnID
+			}
+		}
+	}
+	return ""
+}
+
+func nestedTurnID(value any) string {
+	switch typed := value.(type) {
+	case map[string]any:
+		for _, key := range []string{"turn_id", "turnId"} {
+			if turnID, ok := typed[key].(string); ok && strings.TrimSpace(turnID) != "" {
+				return strings.TrimSpace(turnID)
+			}
+		}
+		for _, child := range typed {
+			if turnID := nestedTurnID(child); turnID != "" {
+				return turnID
+			}
+		}
+	case []any:
+		for _, child := range typed {
+			if turnID := nestedTurnID(child); turnID != "" {
+				return turnID
+			}
+		}
+	}
+	return ""
+}
