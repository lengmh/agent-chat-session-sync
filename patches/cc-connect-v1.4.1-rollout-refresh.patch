+// TestExternalSessionUpdate_RecyclesBeforeIncomingMessage locks down the
+// local-first Codex journey: Desktop appends T11 after cc-connect observed T10,
+// then the next platform message must resume the same rollout in a new process.
+func TestExternalSessionUpdate_RecyclesBeforeIncomingMessage(t *testing.T) {
+	threadID := "shared-rollout"
+	newSess := newControllableSession(threadID)
+	var resumedWith string
+	agent := &controllableAgent{startSessionFn: func(_ context.Context, sessionID string) (AgentSession, error) {
+		resumedWith = sessionID
+		return newSess, nil
+	}}
+	p := &stubPlatformEngine{n: "test"}
+	e := NewEngine("test", agent, []Platform{p}, "", LangEnglish)
+	key := "test:user1"
+	oldBase := newControllableSession(threadID)
+	oldSess := &externallyUpdatedAgentSession{controllableAgentSession: oldBase, updated: true}
+	e.interactiveMu.Lock()
+	e.interactiveStates[key] = &interactiveState{agentSession: oldSess, platform: p, replyCtx: "ctx"}
+	e.interactiveMu.Unlock()
+
+	session := &Session{AgentSessionID: threadID}
+	state := e.getOrCreateInteractiveStateWith(key, p, "ctx", session, e.sessions, nil, "")
+
+	if state.agentSession != newSess {
+		t.Fatal("expected externally stale process to be replaced")
+	}
+	if resumedWith != threadID {
+		t.Fatalf("StartSession called with %q, want shared rollout %q", resumedWith, threadID)
+	}
+	select {
+	case <-oldBase.closed:
+	case <-time.After(2 * time.Second):
+		t.Fatal("externally stale process was not closed before resume")
+	}
+}
