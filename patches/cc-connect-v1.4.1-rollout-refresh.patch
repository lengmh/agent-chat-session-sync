+func TestAppServerSession_ExternalDesktopTurnRequiresResume(t *testing.T) {
+	codexHome := t.TempDir()
+	threadID := "019fab53-93d9-7032-aecf-29b5f9bcc362"
+	rolloutDir := filepath.Join(codexHome, "sessions", "2026", "07", "30")
+	if err := os.MkdirAll(rolloutDir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	rolloutPath := filepath.Join(rolloutDir, "rollout-test-"+threadID+".jsonl")
+	initial := "{\"type\":\"session_meta\",\"payload\":{\"id\":\"" + threadID + "\"}}\n" +
+		"{\"type\":\"event_msg\",\"payload\":{\"type\":\"task_complete\",\"turn_id\":\"T10\"}}\n"
+	if err := os.WriteFile(rolloutPath, []byte(initial), 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	s := &appServerSession{codexHome: codexHome}
+	s.threadID.Store(threadID)
+	if err := s.recordRolloutBaseline(""); err != nil {
+		t.Fatalf("record baseline: %v", err)
+	}
+
+	appendRollout := func(line string) {
+		file, err := os.OpenFile(rolloutPath, os.O_APPEND|os.O_WRONLY, 0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, err := file.WriteString(line + "\n"); err != nil {
+			_ = file.Close()
+			t.Fatal(err)
+		}
+		if err := file.Close(); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	// Persistence may trail turn/completed. More bytes from T10 must advance
+	// the baseline without forcing an unnecessary process restart.
+	appendRollout("{\"type\":\"response_item\",\"payload\":{\"turn_id\":\"T10\"}}")
+	updated, err := s.ExternallyUpdated()
+	if err != nil || updated {
+		t.Fatalf("same-turn append: updated=%v err=%v, want false", updated, err)
+	}
+
+	// Desktop then appends a distinct turn. The next platform message must
+	// recycle this process and resume the shared rollout before turn/start.
+	appendRollout("{\"type\":\"event_msg\",\"payload\":{\"turn_id\":\"T11\"}}")
+	updated, err = s.ExternallyUpdated()
+	if err != nil || !updated {
+		t.Fatalf("external turn append: updated=%v err=%v, want true", updated, err)
+	}
+}
