+// ExternalSessionUpdateDetector is an optional capability for persistent
+// agent sessions whose transcript can also be written by another client.
+// The engine checks it immediately before reusing an idle live process. A true
+// result causes the process to be closed and the same agent session ID to be
+// resumed, so the incoming platform message sees the externally appended turn.
+type ExternalSessionUpdateDetector interface {
+	ExternallyUpdated() (bool, error)
+}
