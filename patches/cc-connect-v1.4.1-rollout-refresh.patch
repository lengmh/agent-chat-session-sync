+func TestExternalSessionUpdateCheckErrorKeepsLiveProcess(t *testing.T) {
+	agent := &controllableAgent{}
+	p := &stubPlatformEngine{n: "test"}
+	e := NewEngine("test", agent, []Platform{p}, "", LangEnglish)
+	key := "test:user1"
+	base := newControllableSession("shared-rollout")
+	live := &externallyUpdatedAgentSession{controllableAgentSession: base, err: errors.New("rollout temporarily unavailable")}
+	existing := &interactiveState{agentSession: live, platform: p, replyCtx: "ctx"}
+	e.interactiveMu.Lock()
+	e.interactiveStates[key] = existing
+	e.interactiveMu.Unlock()
+
+	state := e.getOrCreateInteractiveStateWith(
+		key, p, "ctx", &Session{AgentSessionID: "shared-rollout"}, e.sessions, nil, "",
+	)
+	if state != existing {
+		t.Fatal("transient fingerprint errors must not drop the incoming message or recycle a healthy process")
+	}
+}
