+// refreshInteractiveStateBeforeQueuedSend applies the same external-rollout
+// check used for a newly arriving message immediately before a queued message
+// is sent. A Desktop turn can land while the platform message is waiting behind
+// an active turn, so checking only at queue insertion is not sufficient.
+func (e *Engine) refreshInteractiveStateBeforeQueuedSend(
+	state *interactiveState,
+	session *Session,
+	sessions *SessionManager,
+	sessionKey string,
+) *interactiveState {
+	state.mu.Lock()
+	currentAgentSession := state.agentSession
+	p := state.platform
+	replyCtx := state.replyCtx
+	agent := state.agent
+	workspaceDir := state.workspaceDir
+	ccSessionKey := state.ccSessionKey
+	state.mu.Unlock()
+	detector, supported := currentAgentSession.(ExternalSessionUpdateDetector)
+	if !supported {
+		return state
+	}
+	externallyUpdated, err := detector.ExternallyUpdated()
+	if err != nil {
+		slog.Warn("could not check queued agent session for external updates",
+			"session_key", sessionKey, "error", err)
+		return state
+	}
+	if !externallyUpdated {
+		return state
+	}
+
+	var agentOverride Agent
+	if agent != nil && agent != e.agent {
+		agentOverride = agent
+	}
+	refreshed := e.getOrCreateInteractiveStateWith(
+		sessionKey, p, replyCtx, session, sessions, agentOverride, ccSessionKey, true,
+	)
+	if workspaceDir != "" {
+		refreshed.mu.Lock()
+		refreshed.workspaceDir = workspaceDir
+		refreshed.mu.Unlock()
+	}
+	return refreshed
+}
