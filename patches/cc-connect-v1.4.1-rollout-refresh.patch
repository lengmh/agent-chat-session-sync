+// TestExternalSessionUpdate_RecyclesAgainBeforeQueuedSend covers the window in
+// which Desktop appends a turn after a platform message was queued behind an
+// active cc-connect turn. The pending message must move to a resumed process;
+// it must never be sent through the stale process that accepted the first turn.
+func TestExternalSessionUpdate_RecyclesAgainBeforeQueuedSend(t *testing.T) {
+	threadID := "shared-rollout"
+	newSess := newControllableSession(threadID)
+	var resumedWith string
+	agent := &controllableAgent{startSessionFn: func(_ context.Context, sessionID string) (AgentSession, error) {
+		resumedWith = sessionID
+		return newSess, nil
+	}}
+	p := &stubPlatformEngine{n: "test"}
+	e := NewEngine("test", agent, []Platform{p}, "", LangEnglish)
+	key := "test:user1"
+	oldBase := newControllableSession(threadID)
+	oldSess := &externallyUpdatedAgentSession{controllableAgentSession: oldBase, updated: true}
+	queued := queuedMessage{content: "queued after Desktop turn", platform: p, replyCtx: "queued-ctx"}
+	oldState := &interactiveState{
+		agentSession:    oldSess,
+		platform:        p,
+		replyCtx:        "ctx",
+		agent:           agent,
+		pendingMessages: []queuedMessage{queued},
+	}
+	e.interactiveMu.Lock()
+	e.interactiveStates[key] = oldState
+	e.interactiveMu.Unlock()
+
+	state := e.refreshInteractiveStateBeforeQueuedSend(
+		oldState, &Session{AgentSessionID: threadID}, e.sessions, key,
+	)
+
+	if oldSess.checks != 1 {
+		t.Fatalf("external update checks = %d, want 1 immediately before queued send", oldSess.checks)
+	}
+	if state == oldState || state.agentSession != newSess {
+		t.Fatal("expected queued message to use a newly resumed agent process")
+	}
+	if resumedWith != threadID {
+		t.Fatalf("StartSession called with %q, want %q", resumedWith, threadID)
+	}
+	if len(state.pendingMessages) != 1 || state.pendingMessages[0].content != queued.content {
+		t.Fatal("queued message was not adopted by the replacement state")
+	}
+	if len(oldState.pendingMessages) != 0 {
+		t.Fatal("queued message remained attached to the stale state")
+	}
+	select {
+	case <-oldBase.closed:
+	case <-time.After(2 * time.Second):
+		t.Fatal("stale process was not closed before queued send")
+	}
+}
