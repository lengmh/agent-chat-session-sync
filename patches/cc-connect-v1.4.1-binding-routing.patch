+func TestHandleBindAgentSessionRegistersPlatformRoute(t *testing.T) {
+	platform := &routeRecordingPlatform{stubPlatformEngine: stubPlatformEngine{n: "feishu"}}
+	engine := NewEngine("projectA", &stubAgent{}, []Platform{platform}, "", LangEnglish)
+	api := &APIServer{engines: map[string]*Engine{"projectA": engine}}
+	body, err := json.Marshal(BindAgentSessionRequest{
+		Project: "projectA", SessionKey: "feishu:oc_chat:ou_user", SessionID: "native-session",
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	rec := httptest.NewRecorder()
+	api.handleBindAgentSession(rec, httptest.NewRequest(http.MethodPost, "/sessions/bind-agent", bytes.NewReader(body)))
+	if rec.Code != http.StatusOK {
+		t.Fatalf("status = %d, body=%s", rec.Code, rec.Body.String())
+	}
+	if len(platform.keys) != 1 || platform.keys[0] != "feishu:oc_chat:ou_user" {
+		t.Fatalf("registered routes = %#v", platform.keys)
+	}
+}
