+// BindSessionRoute tells every routing-aware platform owned by this engine
+// that future messages for sessionKey belong to this project.
+func (e *Engine) BindSessionRoute(sessionKey string) {
+	for _, platform := range e.platforms {
+		if binder, ok := platform.(SessionRouteBinder); ok {
+			binder.BindSessionRoute(sessionKey)
+		}
+	}
+}
