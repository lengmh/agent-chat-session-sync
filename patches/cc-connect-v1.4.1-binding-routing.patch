+func TestBindingRoutingAllowsOnlyRegisteredOrStaticChats(t *testing.T) {
+	p := &Platform{bindingRouting: true, allowChat: "oc_static"}
+	if p.chatAllowed("oc_unbound") {
+		t.Fatal("unbound chat was allowed while binding routing is enabled")
+	}
+	p.BindSessionRoute("feishu:oc_bound:ou_user")
+	if !p.chatAllowed("oc_bound") {
+		t.Fatal("bound chat was rejected")
+	}
+	if !p.chatAllowed("oc_static") {
+		t.Fatal("explicit static allow_chat was rejected")
+	}
+	legacy := &Platform{bindingRouting: false, allowChat: ""}
+	if !legacy.chatAllowed("oc_any") {
+		t.Fatal("legacy empty allow_chat behavior changed")
+	}
+}
