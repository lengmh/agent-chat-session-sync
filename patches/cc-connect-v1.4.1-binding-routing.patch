+func (p *Platform) BindSessionRoute(sessionKey string) {
+	parts := strings.Split(sessionKey, ":")
+	if len(parts) < 2 || parts[1] == "" {
+		return
+	}
+	p.boundChats.Store(parts[1], struct{}{})
+}
+
+func (p *Platform) chatAllowed(chatID string) bool {
+	if !p.bindingRouting {
+		return core.AllowList(p.allowChat, chatID)
+	}
+	if _, ok := p.boundChats.Load(chatID); ok {
+		return true
+	}
+	return strings.TrimSpace(p.allowChat) != "" && core.AllowList(p.allowChat, chatID)
+}
