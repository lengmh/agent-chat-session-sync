+func TestAppServerCommandArgs(t *testing.T) {
+	tests := []struct {
+		name, lifecycle, url, socket string
+		want                         []string
+		wantErr                      bool
+	}{
+		{name: "stdio", lifecycle: "stdio", url: "stdio://", want: []string{"app-server", "--stdio"}},
+		{name: "daemon default socket", lifecycle: "daemon", want: []string{"app-server", "proxy"}},
+		{name: "daemon explicit socket", lifecycle: "daemon", socket: "/run/user/501/codex.sock", want: []string{"app-server", "proxy", "--sock", "/run/user/501/codex.sock"}},
+		{name: "reject websocket with stdio connector", lifecycle: "stdio", url: "ws://127.0.0.1:3845", wantErr: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := appServerCommandArgs(tt.lifecycle, tt.url, tt.socket)
+			if (err != nil) != tt.wantErr {
+				t.Fatalf("error = %v, wantErr %v", err, tt.wantErr)
+			}
+			if strings.Join(got, "\x00") != strings.Join(tt.want, "\x00") {
+				t.Fatalf("args = %#v, want %#v", got, tt.want)
+			}
+		})
+	}
+}
+
+func TestAppServerThreadRequestParamsPermissionProfileIsMutuallyExclusive(t *testing.T) {
+	s := &appServerSession{workDir: "/tmp/project", mode: "yolo", permissionProfile: "workspace-safe"}
+	params := s.threadRequestParams()
+	if params["permissions"] != "workspace-safe" {
+		t.Fatalf("permissions = %#v", params["permissions"])
+	}
+	if _, exists := params["sandbox"]; exists {
+		t.Fatal("sandbox must not be sent with permissions")
+	}
+	if _, exists := params["approvalPolicy"]; exists {
+		t.Fatal("approvalPolicy must not override a permission profile")
+	}
+	if params["cwd"] != "/tmp/project" {
+		t.Fatalf("cwd = %#v", params["cwd"])
+	}
+}
