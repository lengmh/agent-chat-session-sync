+func (s *appServerSession) verifyPermissionProfile() error {
+	profile := strings.TrimSpace(s.permissionProfile)
+	if profile == "" {
+		return nil
+	}
+	var cursor *string
+	for {
+		params := map[string]any{"cwd": s.GetWorkDir()}
+		if cursor != nil {
+			params["cursor"] = *cursor
+		}
+		var resp permissionProfileListResponse
+		if err := s.request("permissionProfile/list", params, &resp); err != nil {
+			return fmt.Errorf("codex app-server permission profile discovery: %w", err)
+		}
+		for _, candidate := range resp.Data {
+			if candidate.ID == profile {
+				if !candidate.Allowed {
+					return fmt.Errorf("codex app-server permission profile %q is denied by effective requirements for %s", profile, s.GetWorkDir())
+				}
+				return nil
+			}
+		}
+		if resp.NextCursor == nil || strings.TrimSpace(*resp.NextCursor) == "" {
+			break
+		}
+		cursor = resp.NextCursor
+	}
+	return fmt.Errorf("codex app-server permission profile %q is not available for %s", profile, s.GetWorkDir())
+}
