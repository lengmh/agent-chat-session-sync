+// BindAgentSessionRequest binds a platform conversation directly to an
+// existing native agent session. This is intentionally local-only: APIServer
+// listens on a mode-0600 Unix socket.
+type BindAgentSessionRequest struct {
+	Project     string `json:"project"`
+	SessionKey  string `json:"session_key"`
+	SessionID   string `json:"session_id"`
+	SessionName string `json:"session_name,omitempty"`
+	WorkDir     string `json:"work_dir,omitempty"`
+}
+
+func (s *APIServer) handleBindAgentSession(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodPost {
+		http.Error(w, "POST only", http.StatusMethodNotAllowed)
+		return
+	}
+
+	var req BindAgentSessionRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
+		http.Error(w, "invalid JSON: "+err.Error(), http.StatusBadRequest)
+		return
+	}
+	if strings.TrimSpace(req.SessionKey) == "" || strings.TrimSpace(req.SessionID) == "" {
+		http.Error(w, "session_key and session_id are required", http.StatusBadRequest)
+		return
+	}
+
+	s.mu.RLock()
+	engine, ok := s.engines[req.Project]
+	if req.Project == "" && len(s.engines) == 1 {
+		for _, candidate := range s.engines {
+			engine = candidate
+			ok = true
+		}
+	}
+	s.mu.RUnlock()
+	if !ok {
+		http.Error(w, fmt.Sprintf("project %q not found", req.Project), http.StatusNotFound)
+		return
+	}
+
+	name := strings.TrimSpace(req.SessionName)
+	if name == "" {
+		name = req.SessionID
+	}
+	agent := engine.GetAgent()
+	sessions := engine.sessions
+	bindingChannelKey := ""
+	bindingWorkDir := ""
+	workDir := strings.TrimSpace(req.WorkDir)
+	if workDir != "" {
+		if !engine.multiWorkspace || engine.workspaceBindings == nil {
+			http.Error(w, "work_dir requires a multi-workspace project", http.StatusConflict)
+			return
+		}
+		resolved, err := resolveLocalDirPath(workDir, engine.baseDir)
+		if err != nil {
+			http.Error(w, "invalid work_dir: "+err.Error(), http.StatusUnprocessableEntity)
+			return
+		}
+		base, err := filepath.Abs(engine.baseDir)
+		if err != nil {
+			http.Error(w, "invalid project base_dir", http.StatusInternalServerError)
+			return
+		}
+		if evaluated, evalErr := filepath.EvalSymlinks(base); evalErr == nil {
+			base = evaluated
+		}
+		rel, err := filepath.Rel(base, resolved)
+		if err != nil || rel == ".." || strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
+			http.Error(w, "work_dir is outside project base_dir", http.StatusUnprocessableEntity)
+			return
+		}
+		info, err := os.Stat(resolved)
+		if err != nil || !info.IsDir() {
+			http.Error(w, "work_dir does not exist or is not a directory", http.StatusUnprocessableEntity)
+			return
+		}
+		channelKey := extractWorkspaceChannelKey(req.SessionKey)
+		if channelKey == "" {
+			http.Error(w, "cannot derive workspace channel from session_key", http.StatusBadRequest)
+			return
+		}
+		workspaceAgent, workspaceSessions, err := engine.getOrCreateWorkspaceAgent(resolved)
+		if err != nil {
+			http.Error(w, "create workspace agent: "+err.Error(), http.StatusInternalServerError)
+			return
+		}
+		agent = workspaceAgent
+		sessions = workspaceSessions
+		bindingChannelKey = channelKey
+		bindingWorkDir = resolved
+	}
+	if validator, supported := agent.(SessionIDValidator); supported && !validator.ValidateSessionID(r.Context(), req.SessionID) {
+		http.Error(w, "agent session not found in the configured project", http.StatusUnprocessableEntity)
+		return
+	}
+	if bindingChannelKey != "" {
+		engine.workspaceBindings.Bind("project:"+engine.name, bindingChannelKey, name, bindingWorkDir)
+	}
+	session := sessions.SwitchToAgentSession(req.SessionKey, req.SessionID, agent.Name(), name)
+	apiJSON(w, http.StatusOK, map[string]string{
+		"status":           "ok",
+		"session_key":      req.SessionKey,
+		"agent_session_id": req.SessionID,
+		"session_id":       session.ID,
+	})
+}
