diff --git a/core/api_unix.go b/core/api_unix.go
new file mode 100644
index 0000000000000000000000000000000000000000..bd1918d68930f05fb36d7ddc1dcc185b8c9e3adc
--- /dev/null
+++ b/core/api_unix.go
@@ -0,0 +1,42 @@
+//go:build !windows
+
+package core
+
+import (
+	"fmt"
+	"net"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+func newLocalAPIListener(dataDir, endpoint string) (string, string, net.Listener, error) {
+	socketDir := filepath.Join(dataDir, "run")
+	if err := os.MkdirAll(socketDir, 0o755); err != nil {
+		return "", "", nil, fmt.Errorf("create run dir: %w", err)
+	}
+	socketPath := filepath.Join(socketDir, "api.sock")
+	if endpoint != "" {
+		if !strings.HasPrefix(endpoint, "unix://") {
+			return "", "", nil, fmt.Errorf("local endpoint transport is not supported on this platform")
+		}
+		socketPath = strings.TrimPrefix(endpoint, "unix://")
+	}
+	_ = os.Remove(socketPath)
+	listener, err := net.Listen("unix", socketPath)
+	if err != nil {
+		return "", "", nil, fmt.Errorf("listen unix socket: %w", err)
+	}
+	if err := os.Chmod(socketPath, 0o600); err != nil {
+		_ = listener.Close()
+		return "", "", nil, fmt.Errorf("chmod socket: %w", err)
+	}
+	return socketPath, "unix", listener, nil
+}
+
+func removeLocalAPIEndpoint(path string) error {
+	if err := os.Remove(path); err != nil && !os.IsNotExist(err) {
+		return err
+	}
+	return nil
+}
diff --git a/core/api_windows.go b/core/api_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..4462de47e5caac175eaf5f8ff63db68f3836534b
--- /dev/null
+++ b/core/api_windows.go
@@ -0,0 +1,45 @@
+//go:build windows
+
+package core
+
+import (
+	"crypto/sha256"
+	"fmt"
+	"net"
+	"os/user"
+	"strings"
+
+	winio "github.com/Microsoft/go-winio"
+)
+
+func newLocalAPIListener(_ string, endpoint string) (string, string, net.Listener, error) {
+	current, err := user.Current()
+	if err != nil {
+		return "", "", nil, fmt.Errorf("resolve current user: %w", err)
+	}
+	hash := sha256.Sum256([]byte(current.Uid))
+	pipePath := fmt.Sprintf(`\\.\pipe\cc-connect-api-%x`, hash[:8])
+	if endpoint != "" {
+		const prefix = "npipe://./pipe/"
+		if !strings.HasPrefix(endpoint, prefix) || strings.TrimPrefix(endpoint, prefix) == "" {
+			return "", "", nil, fmt.Errorf("invalid Windows named pipe endpoint")
+		}
+		pipePath = `\\.\pipe\` + strings.TrimPrefix(endpoint, prefix)
+	}
+	securityDescriptor := fmt.Sprintf(
+		"D:P(A;;GA;;;%s)(A;;GA;;;SY)(A;;GA;;;BA)",
+		current.Uid,
+	)
+	listener, err := winio.ListenPipe(pipePath, &winio.PipeConfig{
+		SecurityDescriptor: securityDescriptor,
+		MessageMode:        false,
+	})
+	if err != nil {
+		return "", "", nil, fmt.Errorf("listen named pipe: %w", err)
+	}
+	return pipePath, "npipe", listener, nil
+}
+
+func removeLocalAPIEndpoint(string) error {
+	return nil
+}
